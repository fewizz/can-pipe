{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"fewizz"
	],
	"contact": {
		"sources": "https://github.com/fewizz/can-pipe"
	},
	"license": "${license}",
	"entrypoints": { 
		"client": [
			"fewizz.canpipe.CanPipeClientInitializer"
		]
	},
	"icon": "assets/${mod_id}/icon.png",
	"environment": "client",
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.b3d.mixins.json",
		"${mod_id}.indigo.mixins.json",
		"${mod_id}.compat.cinnabar.mixins.json",
		"${mod_id}.compat.cinnabar.fabric.mixins.json"
	],
	"accessWidener" : "${mod_id}.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.2",
		"minecraft": "${minecraft_version}",
		"java": ">=21"
	}
}